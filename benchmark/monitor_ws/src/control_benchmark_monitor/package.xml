<?xml version="1.0"?>
<package format="3">
  <name>control_benchmark_monitor</name>
  <version>0.1.0</version>
  <description>Monitoring and benchmark logger for Autoware control experiments.</description>
  <maintainer email="nit-user@example.com">nit-user</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>autoware_planning_msgs</exec_depend>
  <exec_depend>autoware_control_msgs</exec_depend>
  <exec_depend>autoware_vehicle_msgs</exec_depend>
  <exec_depend>autoware_internal_debug_msgs</exec_depend>
  <exec_depend>tier4_simulation_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
