<?xml version="1.0"?>
<package format="3">
  <name>autoware_integrated_mpc_trajectory_follower</name>
  <version>0.1.0</version>

  <description>
    Integrated lateral-longitudinal MPC trajectory follower for Autoware.
  </description>

  <maintainer email="marijanink@gmail.com">Marija Ninkovic</maintainer>

  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>

  <depend>autoware_adapi_v1_msgs</depend>
  <depend>autoware_control_msgs</depend>
  <depend>autoware_planning_msgs</depend>
  <depend>autoware_vehicle_msgs</depend>
  <depend>eigen</depend>
  <depend>autoware_osqp_interface</depend>
  <depend>autoware_internal_debug_msgs</depend>
  <depend>diagnostic_updater</depend>

  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
